<Window x:Class="Pianyu.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" KeyDown="Window_OnKeyDown" Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="22">
        <TextBlock x:Name="PromptTitle" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="PromptLabel" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,6" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel_OnClick" Margin="0,0,8,0" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Confirm_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
