<Window x:Class="Pianyu.App.Views.SnippetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pianyu.App.Infrastructure"
        Title="{Binding WindowTitle}" Width="980" Height="740" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False" KeyDown="Window_OnKeyDown" Style="{StaticResource AppWindowStyle}">
    <Window.Resources><infra:BoolToVisibilityConverter x:Key="BoolVisible" /><infra:InverseBoolToVisibilityConverter x:Key="BoolCollapsed" /></Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="纯文本会原样保存；模板变量使用 {name=default}。" Style="{StaticResource MutedText}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,12">
                <TextBlock Text="标题" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="片段标题" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="正文" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="插入变量" HorizontalAlignment="Right" Padding="9,3" MinHeight="26" Click="InsertVariable_OnClick" />
                </Grid>
                <TextBox Grid.Row="1" x:Name="ContentBox" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14" TextBlock.LineHeight="23" Margin="0,7,0,0" AutomationProperties.Name="片段正文" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="标签（空格或逗号分隔）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="片段标签" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,22,0,0" Orientation="Horizontal">
                    <CheckBox Content="收藏" IsChecked="{Binding IsFavorite}" Margin="0,0,14,0" />
                    <CheckBox Content="置顶" IsChecked="{Binding IsPinned}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="删除" Style="{StaticResource DangerButton}" Click="Delete_OnClick" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisible}}" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消  Esc" Click="Cancel_OnClick" Margin="0,0,8,0" />
                    <Button Content="保存  Ctrl+S" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="模型辅助（点击生成）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="点击上方功能生成建议；下方选择后再采用，原文不会自动覆盖。" Style="{StaticResource MutedText}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button Content="生成标题" Click="SuggestTitle_OnClick" Padding="9,5" Margin="0,0,5,5" />
                    <Button Content="推荐标签" Click="SuggestTags_OnClick" Padding="9,5" Margin="0,0,5,5" />
                    <Button Content="生成摘要" Click="SuggestSummary_OnClick" Padding="9,5" Margin="0,0,5,5" />
                    <Button Content="整理文本" Click="SuggestRewrite_OnClick" Padding="9,5" Margin="0,0,5,5" />
                    <Button Content="合并建议" Click="SuggestMerge_OnClick" Padding="9,5" Margin="0,0,5,5" />
                    <Button Content="识别变量" Click="SuggestVariables_OnClick" Padding="9,5" Margin="0,0,5,5" />
                </WrapPanel>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}" FontSize="10" /><TextBlock Text="{Binding Value}" FontSize="12" Margin="0,4,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSuggestions, Converter={StaticResource BoolCollapsed}}">
                        <TextBlock Text="尚未生成建议" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="点击上方按钮开始生成" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="3" Content="采用选中建议" IsEnabled="{Binding HasSuggestions}" Click="ApplySuggestion_OnClick" Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
