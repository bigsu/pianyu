<Window x:Class="Pianyu.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:infra="clr-namespace:Pianyu.App.Infrastructure"
        Title="片语" Width="1240" Height="780" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False" Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource CanvasBrush}">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVisible" />
        <infra:InverseBoolToVisibilityConverter x:Key="BoolCollapsed" />
        <infra:NullToVisibilityConverter x:Key="NullVisible" />
        <infra:StringEmptyToVisibilityConverter x:Key="StringEmptyVisible" />
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="9" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                        <TextBlock Text="片" Foreground="#071512" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="片语" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  本地文本片段" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_OnClick" ToolTip="最小化" Margin="0,4" />
                    <Button Style="{StaticResource IconButton}" Content="×" Click="Close_OnClick" ToolTip="关闭到托盘" Margin="3,4,6,4" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="42,12,12,12" MinHeight="52"
                             AutomationProperties.Name="搜索片段" />
                    <TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,2" IsHitTestVisible="False" />
                    <TextBlock Text="搜索片段或输入命令…" Foreground="{DynamicResource TextMutedBrush}" FontSize="17" Margin="43,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringEmptyVisible}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="＋ 新建" Style="{StaticResource PrimaryButton}" Click="NewSnippet_OnClick" Margin="0,0,7,0" />
                    <Button Content="剪贴板" Click="Clipboard_OnClick" Margin="0,0,7,0" />
                    <Button Content="管理" Click="Manage_OnClick" Margin="0,0,7,0" />
                    <Button Content="设置" Click="Settings_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedSnippet}" SelectionMode="Single"
                                 MouseDoubleClick="ResultList_OnMouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="8" Margin="0,4,7,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisible}}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="24" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding TagsText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyHint}" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="Enter" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding HasResults, Converter={StaticResource BoolCollapsed}}">
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,8,0,12" />
                            <Button Content="新建片段" Style="{StaticResource PrimaryButton}" Click="NewSnippet_OnClick" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVisible}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedSnippet.Title}" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedSnippet.TagsText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="★" Command="{Binding ToggleFavoriteCommand}" ToolTip="收藏/取消收藏" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource IconButton}" Content="⌖" Command="{Binding TogglePinCommand}" ToolTip="置顶/取消置顶" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource IconButton}" Content="✎" Click="EditSnippet_OnClick" ToolTip="编辑" />
                                </StackPanel>
                            </Grid>
                            <Separator Grid.Row="1" Margin="0,16" Background="{DynamicResource BorderBrush}" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedSnippet.Content}" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14" LineHeight="23" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="复制 " /><Run Text="{Binding SelectedSnippet.CopyCount}" /><Run Text=" 次  ·  创建于 " /><Run Text="{Binding SelectedSnippet.CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" />
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,7,0" />
                                    <Button Content="复制并关闭" Style="{StaticResource PrimaryButton}" Click="CopyClose_OnClick" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolCollapsed}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="选择一个片段查看全文" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Text="↑↓ 选择 · Enter 复制 · Shift+Enter 直接粘贴 · Ctrl+N 新建 · Esc 关闭" />
                <Border Grid.Column="1" Background="{DynamicResource AccentDarkBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="8" Margin="0,3,7,0" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" />
                        <Button Content="撤销" Command="{Binding UndoDeleteCommand}" Padding="7,1" MinHeight="24" Margin="9,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
