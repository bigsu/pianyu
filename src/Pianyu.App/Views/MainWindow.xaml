<Window x:Class="Pianyu.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pianyu.App.Infrastructure"
        Title="片语" Width="700" Height="960" MinWidth="620" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResizeWithGrip" Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource CanvasBrush}" Focusable="True">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVisible" />
        <infra:InverseBoolToVisibilityConverter x:Key="BoolCollapsed" />
    </Window.Resources>

    <Grid x:Name="RootPanel" Background="{DynamicResource CanvasBrush}" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,8,20,10" Background="{DynamicResource HeaderBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="片语" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="本地文本片段" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TopActionButton}" Click="NewSnippet_OnClick" ToolTip="新建片段">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,7,0" /><TextBlock Text="新建" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Style="{StaticResource TopActionButton}" Click="Manage_OnClick" ToolTip="管理片段">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,7,0" /><TextBlock Text="管理" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Style="{StaticResource TopActionButton}" Click="Settings_OnClick" ToolTip="设置">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,7,0" /><TextBlock Text="设置" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,14">
            <TextBox x:Name="SearchBox" Style="{StaticResource CommandSearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="45,12,12,12" MinHeight="56"
                     Background="{DynamicResource SearchBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     AutomationProperties.Name="搜索片段" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="搜索片段或输入命令…" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" Margin="46,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedSnippet}" SelectionMode="Single"
                     ItemContainerStyle="{StaticResource CompactSnippetItem}" MouseDoubleClick="ResultList_OnMouseDoubleClick"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="76">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="8" Margin="0,4,7,0" Visibility="{Binding IsPinned, Converter={StaticResource BoolVisible}}" />
                                    <TextBlock Text="★" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,7,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVisible}}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxHeight="22" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="18" Margin="0,3,0,0" />
                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SnippetTag}"><TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SnippetActionButton}" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="CopyItem_OnClick" PreviewMouseDoubleClick="ActionButton_OnPreviewMouseDoubleClick" ToolTip="复制（空格）" AutomationProperties.Name="复制片段" Margin="0,0,3,0" />
                                <Button Style="{StaticResource SnippetActionButton}" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="EditItem_OnClick" PreviewMouseDoubleClick="ActionButton_OnPreviewMouseDoubleClick" ToolTip="编辑（E）" AutomationProperties.Name="编辑片段" Margin="0,0,3,0" />
                                <Button Style="{StaticResource SnippetActionButton}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="DeleteItem_OnClick" PreviewMouseDoubleClick="ActionButton_OnPreviewMouseDoubleClick" ToolTip="删除（Del）" AutomationProperties.Name="删除片段" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding HasResults, Converter={StaticResource BoolCollapsed}}">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,8,0,12" />
                <Button Content="新建片段" Style="{StaticResource PrimaryButton}" Click="NewSnippet_OnClick" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="16,10">
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Center"
                       Text="↑↓ 选择 · Enter 复制 · Shift+Enter 直接粘贴 · Ctrl+N 新建 · Esc 关闭" />
        </Border>
    </Grid>
</Window>
