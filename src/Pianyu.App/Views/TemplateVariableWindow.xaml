<Window x:Class="Pianyu.App.Views.TemplateVariableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="填写模板变量" Width="560" SizeToContent="Height" MaxHeight="680" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="NoResize" KeyDown="Window_OnKeyDown" Style="{StaticResource AppWindowStyle}">
    <Border Padding="24" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="填写模板变量" Style="{StaticResource PageTitle}" />
                <TextBlock Text="默认值已经填好；修改后按 Enter 生成并复制。" Style="{StaticResource MutedText}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,14" Padding="12">
                <TextBlock Text="{Binding TemplateText}" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ScrollViewer Grid.Row="2" MaxHeight="390" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DefaultValue, StringFormat=默认：{0}}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模板变量值" />
                                    <ItemsControl ItemsSource="{Binding RecentValues}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Click="RecentValue_OnClick" Padding="6,2" MinHeight="23" Margin="0,0,5,3" FontFamily="Cascadia Mono, Consolas" FontSize="10" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Esc 取消" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Click="Cancel_OnClick" Margin="0,0,8,0" /><Button Content="生成并复制  Enter" Style="{StaticResource PrimaryButton}" Click="Confirm_OnClick" /></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
