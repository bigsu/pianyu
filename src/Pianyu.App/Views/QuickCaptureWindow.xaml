<Window x:Class="Pianyu.App.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="来自剪贴板" Width="720" Height="540" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" KeyDown="Window_OnKeyDown" Style="{StaticResource AppWindowStyle}">
    <Border Margin="1" Padding="24" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="来自剪贴板" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="保存前需要你的确认，不会自动写入数据库。" Style="{StaticResource MutedText}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentDarkBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                    <TextBlock x:Name="SourceLabel" Text="手动读取" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                </Border>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,20,0,12">
                <TextBlock Text="标题" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="片段标题" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="正文" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" x:Name="ContentBox" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" TextBlock.LineHeight="22" AutomationProperties.Name="剪贴板正文" />
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="标签（空格或逗号分隔）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="片段标签" />
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,15,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox x:Name="ListenCheckBox" Checked="Listen_OnChecked" Unchecked="Listen_OnUnchecked"><TextBlock x:Name="ListenLabel" Text="监听 10 分钟（仅生成候选，仍需确认）" /></CheckBox>
                <TextBlock Grid.Column="1" x:Name="CountdownText" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="忽略  Esc" Click="Cancel_OnClick" Margin="0,0,8,0" />
                    <Button Content="保存  Enter" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
