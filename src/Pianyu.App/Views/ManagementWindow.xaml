<Window x:Class="Pianyu.App.Views.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签与片段管理" Width="920" Height="740" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="标签与片段管理" Style="{StaticResource PageTitle}" />
                <TextBlock Text="筛选、批量整理和清理本地片段。" Style="{StaticResource MutedText}" />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="Filter_OnChanged" AutomationProperties.Name="筛选片段" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="快速筛选" Style="{StaticResource SectionTitle}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" SelectionChanged="Filter_OnChanged" Margin="0,0,0,14" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="标签" Style="{StaticResource SectionTitle}" />
                            <Button Content="清除" HorizontalAlignment="Right" Padding="7,2" MinHeight="24" Click="ClearTag_OnClick" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" SelectionChanged="Tag_OnChanged">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name, StringFormat=#{0}}" /><TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource TextMutedBrush}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <ListBox ItemsSource="{Binding Items}" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Snippet.Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Snippet.Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Snippet.TagsText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Snippet.CopyCount, StringFormat=复制 {0} 次}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Snippet.CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1">
                <Button Content="重命名标签" Click="RenameTag_OnClick" Margin="0,0,7,0" />
                <Button Content="删除标签" Click="DeleteTag_OnClick" Margin="0,0,7,0" />
                <Button Content="批量添加标签" Click="BatchTag_OnClick" Margin="0,0,7,0" />
                <Button Content="批量删除" Style="{StaticResource DangerButton}" Click="BatchDelete_OnClick" Margin="0,0,7,0" />
                <Button Content="完成" Style="{StaticResource PrimaryButton}" Click="Close_OnClick" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
