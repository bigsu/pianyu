<Window x:Class="Pianyu.App.Views.SnippetDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="片段详情" Width="760" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_OnPreviewKeyDown" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Snippet.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="片段详情" Style="{StaticResource MutedText}" />
        </StackPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Snippet.Tags}" Margin="0,14,0,12">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SnippetTag}"><TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding BlockSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="Block_OnMouseLeftButtonUp" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14" LineHeight="23" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="复制" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center">
                <Run Text="复制 " /><Run Text="{Binding Snippet.CopyCount}" /><Run Text=" 次" /><Run Text="  ·  创建于 " /><Run Text="{Binding Snippet.CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" />
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="关闭  Esc" Click="Close_OnClick" Margin="0,0,8,0" />
                <Button Content="复制片段" Style="{StaticResource PrimaryButton}" Click="Copy_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
