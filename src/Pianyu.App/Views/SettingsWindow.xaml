<Window x:Class="Pianyu.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pianyu.App.Infrastructure"
        Title="片语设置" Width="920" Height="780" MinWidth="780" MinHeight="640" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        PreviewKeyDown="Window_OnPreviewKeyDown" Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVisible" />
        <infra:EnumToBooleanConverter x:Key="EnumBool" />
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="所有配置保存在本地 SQLite；修改快捷键后立即生效。" Style="{StaticResource MutedText}" />
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,16,0,12" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="启动与关闭" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                        <CheckBox Content="开机后启动片语" IsChecked="{Binding Settings.StartWithWindows}" />
                        <CheckBox Content="关闭窗口时保留托盘运行" IsChecked="{Binding Settings.MinimizeToTray}" />
                        <CheckBox Content="普通复制后自动关闭命令面板" IsChecked="{Binding Settings.CloseAfterCopy}" />
                    </StackPanel></Border>
                    <TextBlock Text="默认行为" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="默认排序方式" /><TextBlock Text="主面板初次打开时使用" Style="{StaticResource MutedText}" /></StackPanel>
                        <WrapPanel Grid.Column="1">
                            <RadioButton Content="智能" IsChecked="{Binding Settings.DefaultSort, Converter={StaticResource EnumBool}, ConverterParameter=Smart}" />
                            <RadioButton Content="最近" IsChecked="{Binding Settings.DefaultSort, Converter={StaticResource EnumBool}, ConverterParameter=Recent}" />
                            <RadioButton Content="创建" IsChecked="{Binding Settings.DefaultSort, Converter={StaticResource EnumBool}, ConverterParameter=Created}" />
                            <RadioButton Content="名称" IsChecked="{Binding Settings.DefaultSort, Converter={StaticResource EnumBool}, ConverterParameter=Name}" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="剪贴板临时监听时长" /><TextBlock Text="到期自动停止，不会自动保存" Style="{StaticResource MutedText}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0"><TextBox Text="{Binding Settings.ClipboardListenMinutes}" Width="70" /><TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
                    </Grid></Border>
                    <TextBlock Text="显示" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" />
                    <Border Style="{StaticResource Card}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="界面主题" /><TextBlock Text="切换后立即预览；跟随系统会响应 Windows 外观变化。" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
                        <WrapPanel Grid.Column="1">
                            <RadioButton Content="深色" Checked="ThemePreview_OnChecked" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumBool}, ConverterParameter=Dark}" />
                            <RadioButton Content="浅色" Checked="ThemePreview_OnChecked" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumBool}, ConverterParameter=Light}" />
                            <RadioButton Content="跟随系统" Checked="ThemePreview_OnChecked" IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumBool}, ConverterParameter=System}" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="界面字号" /><TextBlock Text="支持 Windows DPI，可在 0.85–1.35 倍之间调整。" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,18,0,0"><TextBox Text="{Binding Settings.FontScale}" Width="70" /><TextBlock Text="倍" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
                    </Grid></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="快捷键">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="快捷键录制" Style="{StaticResource SectionTitle}" /><TextBlock Text="点击录制框后直接按新的组合键。全局快捷键会同时检测系统占用。" Style="{StaticResource MutedText}" /></StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,12">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding ScopeText}" Style="{StaticResource MutedText}" /></StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Button Content="{Binding Gesture, TargetNullValue=点击录制}" Tag="{Binding}" Click="ShortcutRecord_OnClick" FontFamily="Cascadia Mono, Consolas" HorizontalContentAlignment="Center" />
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="4,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="ShortcutClear_OnClick" ToolTip="清除" Margin="7,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="恢复默认快捷键" HorizontalAlignment="Left" Click="RestoreShortcuts_OnClick" />
                </Grid>
            </TabItem>
            <TabItem Header="搜索与排序">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="智能排序" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                        <CheckBox Content="启用智能排序" IsChecked="{Binding Settings.SmartRanking}" />
                        <CheckBox Content="感知当前前台应用（只调整顺序，不隐藏结果）" IsChecked="{Binding Settings.AppAwareness}" />
                        <TextBlock Text="综合全文匹配、近期使用、复制次数、收藏、置顶和时间衰减。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel></Border>
                    <TextBlock Text="已学习的个人搜索别名" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}"><ItemsControl ItemsSource="{Binding Aliases}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Query}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="{Binding SnippetTitle}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="删除" Tag="{Binding}" Click="DeleteAlias_OnClick" Padding="8,3" MinHeight="26" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="模型服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <Grid><TextBlock Text="可选模型辅助" Style="{StaticResource SectionTitle}" /><Border HorizontalAlignment="Right" Background="{DynamicResource AccentDarkBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource AccentBrush}" /></Border></Grid>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                        <CheckBox Content="启用大模型辅助" IsChecked="{Binding Settings.ModelEnabled}" />
                        <TextBlock Text="模型服务仅提供辅助能力，关闭或连接失败不会影响本地搜索、保存、复制和排序。" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel></Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="服务地址" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Settings.ModelEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="1" Text="API Key" VerticalAlignment="Center" /><PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="2" Text="首选模型" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.ModelName}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="3" Text="备用模型" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.FallbackModelName}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="4" Text="请求超时（秒）" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.ModelTimeoutSeconds}" Margin="0,0,0,9" />
                        <Button Grid.Row="5" Grid.Column="1" Content="测试连接" HorizontalAlignment="Left" Click="TestModel_OnClick" />
                    </Grid>
                    <TextBlock Text="辅助功能（结果都需要确认）" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                    <WrapPanel>
                        <CheckBox Content="自动生成标题" IsChecked="{Binding Settings.ModelFeatures[title]}" Width="180" />
                        <CheckBox Content="推荐标签" IsChecked="{Binding Settings.ModelFeatures[tags]}" Width="180" />
                        <CheckBox Content="文本摘要" IsChecked="{Binding Settings.ModelFeatures[summary]}" Width="180" />
                        <CheckBox Content="语义搜索补充" IsChecked="{Binding Settings.ModelFeatures[semantic]}" Width="180" />
                        <CheckBox Content="改写与格式整理" IsChecked="{Binding Settings.ModelFeatures[rewrite]}" Width="180" />
                        <CheckBox Content="相似片段合并建议" IsChecked="{Binding Settings.ModelFeatures[merge]}" Width="180" />
                        <CheckBox Content="参数变量识别建议" IsChecked="{Binding Settings.ModelFeatures[variables]}" Width="180" />
                    </WrapPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="数据与备份">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="本地数据库" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                        <TextBlock Text="当前数据库路径" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding DatabasePath}" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,12" TextWrapping="Wrap" />
                        <Button Content="打开数据目录" HorizontalAlignment="Left" Click="OpenDataDirectory_OnClick" />
                    </StackPanel></Border>
                    <TextBlock Text="导入、导出与恢复" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,0,0,16"><Button Content="导入 JSON" Click="Import_OnClick" Margin="0,0,7,7" /><Button Content="导出 JSON" Click="Export_OnClick" Margin="0,0,7,7" /><Button Content="立即备份" Click="Backup_OnClick" Margin="0,0,7,7" /><Button Content="恢复备份" Click="Restore_OnClick" Margin="0,0,7,7" /></WrapPanel>
                    <TextBlock Text="数据统计" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Stats.SnippetCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="片段" Style="{StaticResource MutedText}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Stats.TagCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="标签" Style="{StaticResource MutedText}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DatabaseSizeText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="数据库大小" Style="{StaticResource MutedText}" /></StackPanel></Border>
                    </UniformGrid>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Click="Cancel_OnClick" Margin="0,0,8,0" /><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" /></StackPanel></Grid>
    </Grid>
</Window>
