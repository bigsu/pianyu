<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared dark graphite palette from the approved reference. -->
    <Color x:Key="CanvasColor">#1A1A19</Color>
    <Color x:Key="HeaderColor">#1A1A19</Color>
    <Color x:Key="SurfaceColor">#2E2E2D</Color>
    <Color x:Key="SearchColor">#262625</Color>
    <Color x:Key="RaisedColor">#242424</Color>
    <Color x:Key="HoverColor">#2B2B2A</Color>
    <Color x:Key="BorderColor">#363535</Color>
    <Color x:Key="BorderStrongColor">#4A4A49</Color>
    <Color x:Key="TextPrimaryColor">#F0F0EF</Color>
    <Color x:Key="TextSecondaryColor">#B4B4B2</Color>
    <Color x:Key="TextMutedColor">#8E8E8C</Color>
    <Color x:Key="AccentColor">#9DE1ED</Color>
    <Color x:Key="AccentHoverColor">#B2EAF2</Color>
    <Color x:Key="AccentDarkColor">#24393C</Color>
    <Color x:Key="AccentForegroundColor">#101A1B</Color>
    <Color x:Key="WarningColor">#D6A051</Color>
    <Color x:Key="DangerColor">#E77B78</Color>
    <Color x:Key="SuccessColor">#65C68B</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SearchBrush" Color="{StaticResource SearchColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
</ResourceDictionary>
